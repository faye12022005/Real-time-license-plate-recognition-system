# ==============================================================================
# SMART ALPR 2.0 - Configuration Template
# Sao chép file này thành .env hoặc .env.local tại thư mục gốc dự án
# ==============================================================================

# ===== Cơ sở dữ liệu MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=alpr

# ===== Cấu hình Mô hình & Nhận diện AI =====
ALPR_IMAGE_SIZE=640
ALPR_PLATE_CONF=0.35
ALPR_VEHICLE_CONF=0.40
ALPR_CHAR_CONF=0.45
ALPR_FRAME_STRIDE=2
ALPR_MIN_PLATE_VOTES=2

# ===== Cấu hình Frontend Next.js =====
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_TELEMETRY_DISABLED=1
